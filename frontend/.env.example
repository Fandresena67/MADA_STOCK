# MADA STOCK — Frontend (NE PAS COMMITTER LE VRAI .env)
VITE_API_URL=http://localhost:5000/api/v1

# Vérification QR depuis un téléphone (même Wi-Fi) : IP LOCALE du PC, jamais localhost.
# 1. Trouver l'IP : `hostname -I` (ex. 192.168.1.239 sur l'interface Wi-Fi, ignorer les ponts docker).
# 2. Décommenter les 2 lignes, remplacer l'IP, relancer `npm run dev -- --host 0.0.0.0`.
# 3. Côté backend, ajouter http://<IP>:5174 à FRONTEND_URL (CORS) et relancer l'API.
# VITE_PUBLIC_APP_URL=http://192.168.1.239:5174
# VITE_PUBLIC_API_URL=http://192.168.1.239:5000/api/v1
