# MADA STOCK — Backend (NE PAS COMMITTER LE VRAI .env)
NODE_ENV=development
PORT=5000

# PostgreSQL Docker dédié MADA STOCK (ne pas pointer vers 5432/5434 hôtes)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=madastock
DB_USER=madastock
DB_PASSWORD=change_me_strong_password

# JWT — générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_min_64_hex_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
